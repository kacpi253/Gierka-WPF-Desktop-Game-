<UserControl x:Class="Gierka.UI.FlappyGameControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800"
             Focusable="True"
             KeyDown="Canvas_KeyDown" KeyUp="Canvas_KeyUp" Loaded="UserControl_Loaded">

    <Grid>
        <Canvas x:Name="MyCanvas" Background="White" Focusable="True">

            <Image x:Name="flappyPlane" Height="70" Width="180" Canvas.Left="100" Canvas.Top="200" Source="/Images/FlappyBird/plane.png"/>

            <Image x:Name="pipeBottom" Height="260" Width="40" Canvas.Left="400" Canvas.Top="350" Source="/Images/FlappyBird/pipe.png" Stretch="Fill"/>

            <Image x:Name="pipeTop" Height="260" Width="40" Canvas.Left="400" Canvas.Top="-150" Source="/Images/FlappyBird/pipe.png" Stretch="Fill">
                <Image.RenderTransform>
                    <RotateTransform Angle="180" CenterX="30" CenterY="150"/>
                </Image.RenderTransform>
            </Image>
            <Border Background="#FFFFFBF0" BorderBrush="#FF6D1E25" CornerRadius="15" Padding="15,10" BorderThickness="3" >
                <Label x:Name="scoreText" Content="Aktualna głośność: 0" FontSize="24" FontWeight="Bold" Foreground="#FF6D1E25" Canvas.Left="10" Canvas.Top="10"/>
            </Border>
            <TextBlock x:Name="InfoText" Text="Naciśnij SPACJĘ aby grać" FontSize="30" FontWeight="Bold" Foreground="Red" 
                       Canvas.Left="200" Canvas.Top="250" Visibility="Collapsed"/>
        </Canvas>

        <Button Content="Powróć i zapisz głośność" FontSize="16" HorizontalAlignment="Right" Background="#FF6D1E25"  FontWeight="Bold" Foreground="White" VerticalAlignment="Top" Margin="10" Click="ExitGame_Click" Height="40" Width="220"/>
    </Grid>
</UserControl>