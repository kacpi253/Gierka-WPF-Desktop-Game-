<UserControl x:Class="Gierka.UI.Mon"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gierka.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Viewbox Stretch="Fill">
            <Grid Width="800" Height="450">
                <Grid.Background>
                    <ImageBrush ImageSource="/Gierka.UI;component/Images/MonPoPixelizacji.png" Stretch="Fill"/>
                </Grid.Background>
                <Button Content="Powrót" Click="Powrot" HorizontalAlignment="Left" Margin="50,50,0,0" VerticalAlignment="Top" Style="{StaticResource GameButtonStyle}"/>
                <Button Content="Wojciech Jaruzelski" 
                    Click="WJ_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="168,332,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/jarózelski.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Mieczysław Moczar" 
                    Click="MM_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="574,332,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/moczar.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Wasilij Sokołowski" 
                    Click="WS_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="372,282,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/sokolowski.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
