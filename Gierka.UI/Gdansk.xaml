<UserControl x:Class="Gierka.UI.Gdansk"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gierka.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Viewbox Stretch="Fill">
            <Grid Width="800" Height="450">
                <Grid.Background>
                    <ImageBrush ImageSource="/Gierka.UI;component/Images/StoczniaPoPixelizacji.png" Stretch="Fill"/>
                </Grid.Background>
                <Button Content="Powrót" Click="Powrot" HorizontalAlignment="Left" Margin="50,50,0,0" VerticalAlignment="Top" Style="{StaticResource GameButtonStyle}"/>
                <Button Content="Lech Wałęsa" 
                    Click="LW_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="206,95,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/walesa.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Mieczysław Jagielski" 
                    Click="MJ_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="332,332,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/jagielski.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Anna Walentynowicz" 
                    Click="AW_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="593,340,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/walentynowicz.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
