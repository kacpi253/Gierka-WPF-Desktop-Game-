<UserControl x:Class="Gierka.UI.Sejm"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gierka.UI"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Viewbox Stretch="Fill">
            <Grid Width="800" Height="450">
                <Grid.Background>
                    <ImageBrush ImageSource="/Gierka.UI;component/Images/SejmPoPixelizacji.png" Stretch="Fill"/>
                </Grid.Background>

                <Button Content="Powrót" 
                    Click="Powrot" 
                    HorizontalAlignment="Left" 
                    Margin="50,50,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource GameButtonStyle}"/>

                <Button Content="Janusz Korwin Mikke" 
                    Click="JKM_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="195,292,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/korwin.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Edward Gierek" 
                    Click="EG_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="215,20,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/gierek.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>

                <Button Content="Józef Cyrankiewicz" 
                    Click="JC_Quest" 
                    HorizontalAlignment="Left" 
                    Margin="680,225,0,0" 
                    VerticalAlignment="Top" 
                    Style="{StaticResource CharacterButtonStyle}">
                    <Button.Background>
                        <ImageBrush ImageSource="/Gierka.UI;component/Images/postacie/cyrankiewicz.png" Stretch="UniformToFill"/>
                    </Button.Background>
                </Button>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
