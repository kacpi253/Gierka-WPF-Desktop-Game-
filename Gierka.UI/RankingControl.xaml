<UserControl x:Class="Gierka.UI.RankingControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/tymczasowetlo.png" Opacity="0.5"/>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
            <TextBlock Text="RANKING" FontSize="30" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,0,0,20">
                <TextBlock.Effect>
                    <DropShadowEffect Color="Black" BlurRadius="5" ShadowDepth="2"/>
                </TextBlock.Effect>
            </TextBlock>

            <DataGrid x:Name="RankingGrid" AutoGenerateColumns="False" HeadersVisibility="Column" IsReadOnly="True" Height="300" Width="500" Background="#DDFFFFFF" BorderBrush="Gold" BorderThickness="2">
                <DataGrid.Resources>
                    <Style TargetType="DataGridColumnHeader">
                        <Setter Property="FontWeight" Value="Bold"/>
                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                        <Setter Property="Background" Value="#FF922C39"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="Padding" Value="5"/>
                    </Style>
                </DataGrid.Resources>
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Gracz" Binding="{Binding UserName}" Width="*"/>
                    <DataGridTextColumn Header="Złotówki" Binding="{Binding Score}" Width="100"/>
                    <DataGridTextColumn Header="Data" Binding="{Binding Date, StringFormat=\{0:dd.MM.yyyy HH:mm\}}" Width="150"/>
                </DataGrid.Columns>
            </DataGrid>

            <Button Content="Powrót" Click="Powrot" Width="150" Height="40" Margin="0,20,0,0" Style="{StaticResource GameButtonStyle}"/>
        </StackPanel>
    </Grid>
</UserControl>
