<UserControl x:Class="Gierka.UI.Roulette"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:Gierka.UI"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="800">
    <Grid>
        <Grid.Background>
            <ImageBrush ImageSource="/Images/Ruletka/tlo.png" Stretch="UniformToFill" ></ImageBrush>
        </Grid.Background>

        <StackPanel HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="15">
            <Border Background="#CC000000" CornerRadius="15" Padding="15,10" BorderThickness="2" >
                <TextBlock x:Name="WalletText" 
                      Text="Twoje złotówki: 0 PLN" 
                      FontSize="20" 
                      FontWeight="Bold" 
                      Foreground="Gold">
                </TextBlock>

            </Border>
        </StackPanel>

        <!-- Viewbox ensures everything scales to fit the window -->
        <Viewbox Stretch="Uniform" Margin="20">
            <Grid Width="800" Height="650">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Title -->
                    <RowDefinition Height="*"/>
                    <!-- Wheel -->
                    <RowDefinition Height="Auto"/>
                    <!-- Status -->
                    <RowDefinition Height="Auto"/>
                    <!-- Betting -->
                    <RowDefinition Height="Auto"/>
                    <!-- Spin -->
                    <RowDefinition Height="Auto"/>
                    <!-- Back -->
                </Grid.RowDefinitions>

                <!-- Title -->
                <TextBlock Grid.Row="0" Text="RULETKA NARODOWA" FontSize="50" FontWeight="Bold" Foreground="#FF6D1E25" HorizontalAlignment="Center" Margin="0,0,0,20">

                </TextBlock>

                <!-- Wheel Section -->
                <Border x:Name="border" Grid.Row="1" BorderBrush="#FF6D1E25" BorderThickness="8" CornerRadius="130" Width="300" Height="200" Background="White" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock x:Name="WynikLiczba" Text="?" FontSize="80" FontWeight="Bold" Foreground="#FF6D1E25" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,35,0,0"/>
                        <TextBlock x:Name="WynikKolorText" Text="" FontSize="24" Foreground="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,20"/>
                    </Grid>
                </Border>

                <!-- Status -->
                <TextBlock Grid.Row="2" x:Name="StatusText" Text="Postaw zakład ku chwale ojczyzny!" FontSize="26" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" Margin="0,20" TextWrapping="Wrap" TextAlignment="Center"/>

                <!-- Betting Section -->
                <Grid Grid.Row="3" Margin="0,10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Stawka -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,0,0,10">
                        <TextBlock Text="Stawka (PLN): " Foreground="White" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                        <TextBox x:Name="BetInput" Text="50" Width="100" TextAlignment="Center" FontSize="20" FontWeight="Bold" Margin="10,0,0,0"/>
                    </StackPanel>

                    <!-- Colors -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Button x:Name="BtnRed" Content="Czerwone (x2)" Background="#D50000" Foreground="White" Width="160" Height="50" FontSize="18" FontWeight="Bold" Margin="10" Click="BetRed">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                        <Button x:Name="BtnBlack" Content="Czarne (x2)" Background="#212121" Foreground="White" Width="160" Height="50" FontSize="18" FontWeight="Bold" Margin="10" Click="BetBlack">
                            <Button.Resources>
                                <Style TargetType="Border">
                                    <Setter Property="CornerRadius" Value="5"/>
                                </Style>
                            </Button.Resources>
                        </Button>
                    </StackPanel>

                    <!-- Numbers -->
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <TextBlock Text="Numer (0-36): " Foreground="White" FontWeight="Bold" VerticalAlignment="Center" FontSize="18"/>
                        <TextBox x:Name="NumberInput" Width="60" TextAlignment="Center" Margin="10,0" FontSize="30"/>
                        <Button x:Name="BtnNumber" Content="Obstaw Numer (x36)" Width="200" Height="40" FontWeight="Bold" Background="#FF6D1E25" Foreground="White" FontSize="16" Margin="5" Click="BetNumber"/>
                    </StackPanel>

                    <!-- Even/Odd -->
                    <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,5">
                        <Button x:Name="BtnParzyste" Content="Parzyste (x2)" Background="#FF6D1E25" Width="150" Height="40" FontSize="18" FontWeight="Bold" Margin="10" Click="BetParzyste" Foreground="White"/>
                        <Button x:Name="BtnNieparzyste" Content="Nieparzyste (x2)" Background="#FF6D1E25" Width="150" Height="40" FontSize="18" FontWeight="Bold" Margin="10" Click="BetNieparzyste" Foreground="White"/>
                    </StackPanel>
                </Grid>

                <!-- Spin Button -->
                <Button Grid.Row="4" x:Name="BtnSpin" Content="KRĘĆ KOŁEM HISTORII" Click="SpinWheel" Width="400" Height="70" Margin="0,20" Background="#FF6D1E25" Foreground="White" FontSize="28" FontWeight="Bold">
                    <Button.Resources>
                        <Style TargetType="Border">
                            <Setter Property="CornerRadius" Value="10"/>
                        </Style>
                    </Button.Resources>
                </Button>

                <!-- Back Button -->
                <Button Grid.Row="5" Content="Powrót do Kasyna" Click="BackToCasino" Width="200" Height="40" Background="#FF6D1E25" Foreground="White" FontSize="20"/>
            </Grid>
        </Viewbox>
    </Grid>
</UserControl>
